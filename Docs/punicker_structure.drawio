" edge="1" parent="1" source="i_auto" target="i_prog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n6" value="⑤" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#558B2F;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="i_auto" target="i_mps"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#558B2F;" edge="1" parent="1" source="i_wallet" target="i_count"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#558B2F;" edge="1" parent="1" source="i_prog" target="i_bar"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;番号の順に起きること&lt;/b&gt;&lt;br&gt;① Unity が毎フレーム（1秒に約60回）AutoIncome.cs の Update() を呼ぶ&lt;br&gt;② OmiyageShop.cs に「1秒に何もち増える？」と聞き、mpsBoost（1.5倍）を掛ける&lt;br&gt;　 さらに Time.deltaTime（前のフレームからの秒数）を掛けて、このフレームの分にする&lt;br&gt;③ MochiWallet.cs のもちを増やす　④ StageProgress.cs の旅を進める（タップと同じ）&lt;br&gt;⑤ 画面の「自動増加: 〇〇 もち/秒」を書き換える" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=13;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="900" height="136" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;見かた&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1640" y="80" width="260" height="24" as="geometry"/></mxCell><mxCell id="n11" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFF3E0;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="1640" y="110" width="40" height="22" as="geometry"/></mxCell><mxCell id="n12" v
="1470" y="318" width="210" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="② セーブと読み込み" id="pga0e95b92e549"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="② セーブと読み込み：閉じても続きから遊べる仕組み" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="v_head1" value="&lt;b&gt;保存するとき&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="30" as="geometry"/></mxCell><mxCell id="v_trig" value="&lt;b&gt;Unity が呼ぶ3つのきっかけ&lt;/b&gt;&lt;br&gt;Update()：10秒ごと&lt;br&gt;OnApplicationFocus()：離れたとき&lt;br&gt;OnApplicationQuit()：閉じるとき" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#FFF3E0;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="100" as="geometry"/></mxCell><mxCell id="v_save" value="&lt;b&gt;SaveManager.cs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Save()&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;値を集めて保存する&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="380" y="123" width="220" height="74" as="geometry"/></mxCell><mxCell id="v_collect" value="&lt;b&gt;集める値&lt;/b&gt;&lt;br&gt;MochiWallet の Mochi&lt;br&gt;StageProgress の CurrentStageIndex・Progress&lt;br&gt;OmiyageShop の GetLevels()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="680" y="110" width="320" height="100" as="geometry"/></mxCell><mxCell id="v_json" value="&lt;b&gt;SaveData → JSON&lt;/b&gt;&lt;br&gt;JsonUtility.ToJson()&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;1行の文字にする&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#F3E5F5;strokeColor=#6A1B9A;" vertex="1" parent="1"><mxGeometry x="1080" y="118" width="220" height="84" as="geometry"/></mxCell><mxCell id="v_prefs" value="&lt;b&gt;PlayerPrefs&lt;/b&gt;&lt;br&gt;SetString()・Save()" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=13;fillColor=#FFF3E0;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="1380" y="115" width="220" height="90" as="geometry"/></mxCell><mxCell id="n2" value="①" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#E65100;" edge="1" parent="1" source="v_trig" target="v_save"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n3" value="②" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#78909C;dashed=1;" edge="1" parent="1" source="v_save" target="v_collect"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n4" value="③" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#37474F;" edge="1" parent="1" source="v_collect" target="v_json"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n5" value="④" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#37474F;" edge="1" parent="1" source="v_json" target="v_prefs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v_head2" value="&lt;b&gt;読み込むとき（ゲームを開いたとき）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="500" height="30" as="geometry"/></mxCell><mxCell id="v_start" value="&lt;b&gt;Unity が呼ぶ&lt;/b&gt;&lt;br&gt;Start()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#FFF3E0;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="260" height="70" as="geometry"/></mxCell><mxCell id="v_load" value="&lt;b&gt;SaveManager.cs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Load()&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;保存があるときだけ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="380" y="348" width="220" height="74" as="geometry"/></mxCell><mxCell id="v_prefs2" value="&lt;b&gt;PlayerPrefs&lt;/b&gt;&lt;br&gt;HasKey()・GetString()" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=13;fillColor=#FFF3E0;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="680" y="340" width="220" height="90" as="geometry"/></mxCell><mxCell id="v_json2" value="&lt;b&gt;JSON → SaveData&lt;/b&gt;&lt;br&gt;JsonUtility.FromJson()" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#F3E5F5;strokeColor=#6A1B9A;" vertex="1" parent="1"><mxGeometry x="980" y="350" width="220" height="70" as="geometry"/></mxCell><mxCell id="v_r1" value="&lt;b&gt;MochiWallet.cs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Restore()&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;もち数を戻す&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="1280" y="300" width="230" height="66" as="geometry"/></mxCell><mxCell id="v_r2" value="&lt;b&gt;StageProgress.cs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;Restore()&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;県と進み具合を戻す&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="1280" y="386" width="230" height="66" as="geometry"/></mxCell><mxCell id="v_r3" value="&lt;b&gt;OmiyageShop.cs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;RestoreLevels()&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;おみやげのレベルを戻す&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="1280" y="472" width="230" height="66" as="geometry"/></mxCell><mxCell id="n6" value="①" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#E65100;" edge="1" parent="1" source="v_start" target="v_load"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n7" value="②" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#37474F;" edge="1" parent="1" source="v_load" target="v_prefs2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="③" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#37474F;" edge="1" parent="1" source="v_prefs2" target="v_json2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#37474F;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="v_json2" target="v_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="④" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#37474F;" edge="1" parent="1" source="v_json2" target="v_r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#37474F;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="v_json2" target="v_r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;番号の順に起きること&lt;/b&gt;&lt;br&gt;保存：① 10秒ごと・離れたとき・閉じるときに Save() → ② 3つの持ち主から値を集める&lt;br&gt;　　　③ SaveData の入れ物に入れて、JSON（1行の文字）にする → ④ PlayerPrefs に名札を付けてしまい、すぐ書き込む&lt;br&gt;読み込み：① 始まったら Load() → ② 保存があれば取り出す → ③ SaveData に戻す&lt;br&gt;　　　　　④ それぞれの持ち主の Restore() で値を戻す（画面の表示も一緒に戻る）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=13;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1150" height="114" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;見かた&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1640" y="600" width="260" height="24" as="geometry"/></mxCell><mxCell id="n14" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFF3E0;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="1640" y="630" width="40" height="22" as="geometry"/></mxCell><mxCell id="n15" value="Unity の仕組み" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1690" y="628" width="210" height="26" as="geometry"/></mxCell><mxCell id="n16" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFEBEE;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="1640" y="660" width="40" height="22" as="geometry"/></mxCell><mxCell id="n17" value="入力" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;verticalAlign=middle;" vertex="1" p
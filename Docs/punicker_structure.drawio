<mxfile host="Electron" type="device"><diagram name="① ざっくり全体" id="pg41aefbfeb9f9"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="① ざっくり全体：ぷにっかー Unity版は、こんな7つのまとまりでできています" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="player" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;プレイヤー&lt;/font&gt;&lt;/b&gt;&lt;br&gt;もちすけを押す&lt;br&gt;ボタンを押す&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Unity の EventSystem・Button が&lt;br&gt;スクリプトに届ける&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#FFF3E0;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="220" height="100" as="geometry"/></mxCell><mxCell id="g_input" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;入力&lt;/font&gt;&lt;/b&gt;&lt;br&gt;・&lt;b&gt;MochisukeTap.cs&lt;/b&gt;　もちすけのタップ係&lt;br&gt;・&lt;b&gt;StartScreen.cs&lt;/b&gt;　スタート画面&lt;br&gt;・ボタン（On Click）　お店を開く・買う" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;arcSize=6;strokeWidth=2;fillColor=#FFEBEE;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="320" y="200" width="320" height="130" as="geometry"/></mxCell><mxCell id="g_core" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;もちと旅（ゲームの中心）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;・&lt;b&gt;MochiWallet.cs&lt;/b&gt;　もちの財布&lt;br&gt;・&lt;b&gt;AutoIncome.cs&lt;/b&gt;　自動でもちを増やす係&lt;br&gt;・&lt;b&gt;StageProgress.cs&lt;/b&gt;　旅の進み具合&lt;br&gt;・&lt;b&gt;StageView.cs&lt;/b&gt;　背景と県名を出す係&lt;br&gt;・&lt;b&gt;MochiFormat.cs&lt;/b&gt;　数を文字にする道具" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;arcSize=6;strokeWidth=2;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="720" y="190" width="360" height="150" as="geometry"/></mxCell><mxCell id="g_screen" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;画面（Canvas）&lt;/font&gt;&lt;/b&gt;&lt;br&gt;・&lt;b&gt;HeaderFrame&lt;/b&gt;　もち数・県名・制覇数・&lt;br&gt;　自動増加・タップ力&lt;br&gt;・&lt;b&gt;ProgressFrame&lt;/b&gt;　次のエリアまで・バー&lt;br&gt;・&lt;b&gt;Background&lt;/b&gt;　県の背景&lt;br&gt;・飾りのボタン（ロック中）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;arcSize=6;strokeWidth=2;fillColor=#F1F8E9;strokeColor=#558B2F;" vertex="1" parent="1"><mxGeometry x="1160" y="190" width="320" height="150" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;StageDatabase.asset&lt;/b&gt;&lt;br&gt;47県の名前・距離・背景・おみやげ" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fontSize=12;fillColor=#EFEBE9;strokeColor=#6D4C41;fontSize=13;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="280" height="76" as="geometry"/></mxCell><mxCell id="g_fx" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;演出&lt;/font&gt;&lt;/b&gt;&lt;br&gt;・&lt;b&gt;TapEffects.cs&lt;/b&gt;　演出係&lt;br&gt;・&lt;b&gt;FloatingText.cs&lt;/b&gt;　「+1 もち」1つ分&lt;br&gt;・（画面の EffectLayer に出す）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;arcSize=6;strokeWidth=2;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="320" y="470" width="320" height="110" as="geometry"/></mxCell><mxCell id="g_shop" value="&lt;b&gt;&lt;font style='font-size:15px'&gt;お店&lt;/font&gt;&lt;/b&gt;&lt;br&gt;・&lt;b&gt;OmiyageShop.cs&lt;/b&gt;　おみやげの計算係&lt;br&gt;・&lt;b&gt;OmiyageShelf.cs&lt;/b&gt;　棚の表示係&lt;br&gt;・&lt;b&gt;OmiyageSlot.cs&lt;/b&gt;　棚の1マス（9個）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;arcSize=6;strokeWidth=2;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="
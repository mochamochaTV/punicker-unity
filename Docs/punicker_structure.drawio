5;" edge="1" parent="1" source="p_add" target="p_view"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#1565C0;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.3;entryX=0;entryY=0.9;" edge="1" parent="1" source="p_restore" target="p_view"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#78909C;dashed=1;strokeColor=#1565C0;edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="p_restore" target="p_last"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#78909C;dashed=1;strokeColor=#1565C0;" edge="1" parent="1" source="p_next" target="p_last"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="③ 辞典：お店とセーブ" id="pg9765a0914928"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="③ ファイル辞典：お店とセーブ（青い矢印＝同じファイルの中の呼び出し）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1400" height="40" as="geometry"/></mxCell><mxCell id="L_shop" value="OmiyageShop.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：OmiyageShop&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="270" height="670" as="geometry"/></mxCell><mxCell id="o_awake" value="&lt;b&gt;Awake()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;県の数だけレベル0を用意&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shop"><mxGeometry x="15" y="58" width="240" height="44" as="geometry"/></mxCell><mxCell id="o_tap" value="&lt;b&gt;TapPower&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;1＋タップ効果×レベル&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← MochisukeTap が読む&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;dashed=1;fontStyle=2;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shop"><mxGeometry x="15" y="120" width="240" height="59" as="geometry"/></mxCell><mxCell id="o_mps" value="&lt;b&gt;Mps&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;自動増加効果×レベル&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← AutoIncome が読む&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;dashed=1;fontStyle=2;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shop"><mxGeometry x="15" y="197" width="240" height="59" as="geometry"/></mxCell><mxCell id="o_level" value="&lt;b&gt;GetLevel(index)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;今のレベル&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageShelf の UpdateDetail()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shop"><mxGeometry x="15" y="274" width="240" height="59" as="geometry"/></mxCell><mxCell id="o_price" value="&lt;b&gt;GetPrice(index)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;次に買う値段&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageShelf の UpdateDetail()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shop"><mxGeometry x="15" y="351" width="240" height="59" as="geometry"/></mxCell><mxCell id="o_buy" value="&lt;b&gt;TryBuy(index)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;払えたらレベル+1&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageShelf の OnClickBuy()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ MochiWallet の TrySpend()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shop"><mxGeometry x="15" y="428" width="240" height="74" as="geometry"/></mxCell><mxCell id="o_levels" value="&lt;b&gt;GetLevels()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;全部のレベルの写しを渡す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← SaveManager の Save()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shop"><mxGeometry x="15" y="520" width="240" height="59" as="geometry"/></mxCell><mxCell id="o_restore" value="&lt;b&gt;RestoreLevels(savedLevels)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;保存のレベルに戻す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← SaveManager の Load()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shop"><mxGeometry x="15" y="597" width="240" height="59" as="geometry"/></mxCell><mxCell id="L_shelf" value="OmiyageShelf.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：ShopPanel（開いている間だけ動く）&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="560" height="556" as="geometry"/></mxCell><mxCell id="sh_start" value="&lt;b&gt;Start()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;9マスに番号を教える&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ OmiyageSlot の Setup() ×9&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="15" y="58" width="240" height="59" as="geometry"/></mxCell><mxCell id="sh_up" value="&lt;b&gt;Update()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;毎フレーム、画面を合わせる&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ MochiFormat の Format()&lt;/font&gt;&lt;br&gt;&lt;font color='#607D8B'&gt;読む MochiWallet の Mochi&lt;/font&gt;&lt;br&gt;&lt;font color='#33691E'&gt;画面 MoneyText・PageText&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="15" y="135" width="240" height="89" as="geometry"/></mxCell><mxCell id="sh_buy" value="&lt;b&gt;OnClickBuy()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;購入ボタン&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ OmiyageShop の TryBuy()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E1BEE7;strokeColor=#6A1B9A;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="15" y="262" width="240" height="59" as="geometry"/></mxCell><mxCell id="sh_clicked" value="&lt;b&gt;OnSlotClicked(slotNumber)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;押されたマスのおみやげを選ぶ&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageSlot の OnClick()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="15" y="339" width="240" height="59" as="geometry"/></mxCell><mxCell id="sh_next" value="&lt;b&gt;OnClickNextPage()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;＞ ボタン&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E1BEE7;strokeColor=#6A1B9A;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="15" y="436" width="240" height="44" as="geometry"/></mxCell><mxCell id="sh_prev" value="&lt;b&gt;OnClickPrevPage()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;＜ ボタン&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E1BEE7;strokeColor=#6A1B9A;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="15" y="498" width="240" height="44" as="geometry"/></mxCell><mxCell id="sh_slots" value="&lt;b&gt;UpdateSlots()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;9マスに今のページを出す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#607D8B'&gt;読む StageProgress の CurrentStageIndex&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ OmiyageSlot の ShowEmpty()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ OmiyageSlot の ShowLocked()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ OmiyageSlot の ShowItem()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="305" y="58" width="240" height="104" as="geometry"/></mxCell><mxCell id="sh_detail" value="&lt;b&gt;UpdateDetail()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;詳細パネルを出す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ OmiyageShop の GetLevel()・GetPrice()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ MochiFormat の Format()&lt;/font&gt;&lt;br&gt;&lt;font color='#607D8B'&gt;読む MochiWallet の Mochi&lt;/font&gt;&lt;br&gt;&lt;font color='#33691E'&gt;画面 DetailPanel・BuyButton など&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="305" y="180" width="240" height="104" as="geometry"/></mxCell><mxCell id="sh_max" value="&lt;b&gt;MaxPage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;最後のページの番号（プロパティ）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;dashed=1;fontStyle=2;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="305" y="310" width="240" height="44" as="geometry"/></mxCell><mxCell id="sh_change" value="&lt;b&gt;ChangePage(direction)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;ページを進める・戻す&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_shelf"><mxGeometry x="305" y="466" width="240" height="44" as="geometry"/></mxCell><mxCell id="L_slot" value="OmiyageSlot.cs（9個）&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：Slot0〜Slot8&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="950" y="70" width="270" height="439" as="geometry"/></mxCell><mxCell id="sl_setup" value="&lt;b&gt;Setup(ownerShelf, number)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;連絡先の棚と番号をしまう&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageShelf の Start()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_slot"><mxGeometry x="15" y="58" width="240" height="59" as="geometry"/></mxCell><mxCell id="sl_item" value="&lt;b&gt;ShowItem(itemImg, itemName)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;画像と名札を出す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#33691E'&gt;画面 Item・名札・Button&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_slot"><mxGeometry x="15" y="135" width="240" height="59" as="geometry"/></mxCell><mxCell id="sl_lock" value="&lt;b&gt;ShowLocked()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;「？」と「？？？」&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#33691E'&gt;画面 Lock・名札・Button&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_slot"><mxGeometry x="15" y="212" width="240" height="59" as="geometry"/></mxCell><mxCell id="sl_empty" value="&lt;b&gt;ShowEmpty()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;何も出さない&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#33691E'&gt;画面 全部オフ&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_slot"><mxGeometry x="15" y="289" width="240" height="59" as="geometry"/></mxCell><mxCell id="sl_click" value="&lt;b&gt;OnClick()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;押されたことを棚に知らせる&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ OmiyageShelf の OnSlotClicked()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E1BEE7;strokeColor=#6A1B9A;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_slot"><mxGeometry x="15" y="366" width="240" height="59" as="geometry"/></mxCell><mxCell id="L_save" value="SaveManager.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：SaveManager（SaveData クラスも同じファイル）&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="560" height="424" as="geometry"/></mxCell><mxCell id="sv_start" value="&lt;b&gt;Start()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;始まったら読み込む&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_save"><mxGeometry x="15" y="58" width="240" height="44" as="geometry"/></mxCell><mxCell id="sv_up" value="&lt;b&gt;Update()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;10秒ごとに保存&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_save"><mxGeometry x="15" y="120" width="240" height="44" as="geometry"/></mxCell><mxCell id="sv_focus" value="&lt;b&gt;OnApplicationFocus(hasFocus)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;離れたら保存&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_save"><mxGeometry x="15" y="182" width="240" height="44" as="geometry"/></mxCell><mxCell id="sv_quit" value="&lt;b&gt;OnApplicationQuit()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;閉じるときに保存&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_save"><mxGeometry x="15" y="244" width="240" height="44" as="geometry"/></mxCell><mxCell id="sv_load" value="&lt;b&gt;Load()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;読み込んで、持ち主に戻す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ PlayerPrefs の HasKey()・GetString()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ JsonUtility の FromJson()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ MochiWallet の Restore()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ StageProgress の Restore()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ OmiyageShop の RestoreLevels()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_save"><mxGeometry x="305" y="58" width="240" height="119" as="geometry"/></mxCell><mxCell id="sv_save" value="&lt;b&gt;Save()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;値を集めて保存する&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#607D8B'&gt;読む MochiWallet の Mochi&lt;/font&gt;&lt;br&gt;&lt;font color='#607D8B'&gt;読む StageProgress の CurrentStageIndex&lt;/font&gt;&lt;br&gt;&lt;font color='#607D8B'&gt;読む StageProgress の Progress&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ OmiyageShop の GetLevels()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ JsonUtility の ToJson()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ PlayerPrefs の SetString()・Save()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_save"><mxGeometry x="305" y="225" width="240" height="134" as="geometry"/></mxCell><mxCell id="sv_data" value="&lt;b&gt;SaveData&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;保存する中身の型&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;mochi・currentStageIndex・progress&lt;br&gt;levels・lastSaveTime&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;dashed=1;fontStyle=2;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_save"><mxGeometry x="15" y="336" width="240" height="74" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;見かた&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="70" width="380" height="24" as="geometry"/></mxCell><mxCell id="n3" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="1600" y="100" width="40" height="22" as="geometry"/></mxCell><mxCell id="n4" value="Unity が自動で呼ぶ（Awake・Start・Update など）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1650" y="98" width="330" height="26" as="geometry"/></mxCell><mxCell id="n5" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFCDD2;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="1600" y
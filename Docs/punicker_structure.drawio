GraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="③ ファイル辞典：もちと旅（青い矢印＝同じファイルの中の呼び出し）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1400" height="40" as="geometry"/></mxCell><mxCell id="L_wallet" value="MochiWallet.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：MochiWallet&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="560" height="424" as="geometry"/></mxCell><mxCell id="w_start" value="&lt;b&gt;Start()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;最初の表示&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_wallet"><mxGeometry x="15" y="58" width="240" height="44" as="geometry"/></mxCell><mxCell id="w_add" value="&lt;b&gt;Add(amount)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;もちを amount だけ増やす&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← MochisukeTap・AutoIncome&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_wallet"><mxGeometry x="15" y="120" width="240" height="59" as="geometry"/></mxCell><mxCell id="w_spend" value="&lt;b&gt;TrySpend(amount)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;足りれば払って true&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageShop の TryBuy()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_wallet"><mxGeometry x="15" y="197" width="240" height="59" as="geometry"/></mxCell><mxCell id="w_restore" value="&lt;b&gt;Restore(savedMochi)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;保存のもち数に戻す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← SaveManager の Load()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_wallet"><mxGeometry x="15" y="274" width="240" height="59" as="geometry"/></mxCell><mxCell id="w_mochi" value="&lt;b&gt;Mochi&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;今のもち数（プロパティ）&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageShelf・SaveManager が読む&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;dashed=1;fontStyle=2;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_wallet"><mxGeometry x="15" y="351" width="240" height="59" as="geometry"/></mxCell><mxCell id="w_text" value="&lt;b&gt;UpdateText()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;「〇〇 もち」を出す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ MochiFormat の Format()&lt;/font&gt;&lt;br&gt;&lt;font color='#33691E'&gt;画面 MochiCount&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_wallet"><mxGeometry x="305" y="160" width="240" height="74" as="geometry"/></mxCell><mxCell id="L_auto" value="AutoIncome.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：AutoIncome&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="270" height="191" as="geometry"/></mxCell><mxCell id="auto_up" value="&lt;b&gt;Update()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;毎フレーム、自動で増やす&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#607D8B'&gt;読む OmiyageShop の Mps&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ MochiWallet の Add()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ StageProgress の AddProgress()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ MochiFormat の Format()&lt;/font&gt;&lt;br&gt;&lt;font color='#33691E'&gt;画面 MpsText&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_auto"><mxGeometry x="15" y="58" width="240" height="119" as="geometry"/></mxCell><mxCell id="L_prog" value="StageProgress.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：StageProgress&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="950" y="70" width="560" height="470" as="geometry"/></mxCell><mxCell id="p_start" value="&lt;b&gt;Start()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;最初の県とバーを出す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ StageView の ShowStage()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_prog"><mxGeometry x="15" y="58" width="240" height="59" as="geometry"/></mxCell><mxCell id="p_add" value="&lt;b&gt;AddProgress(amount)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;旅を進める&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← MochisukeTap・AutoIncome&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_prog"><mxGeometry x="15" y="135" width="240" height="59" as="geometry"/></mxCell><mxCell id="p_restore" value="&lt;b&gt;Restore(savedStageIndex,&lt;br&gt;savedProgress)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;保存の県と進み具合に戻す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← SaveManager の Load()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ StageView の ShowStage()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_prog"><mxGeometry x="15" y="212" width="240" height="90" as="geometry"/></mxCell><mxCell id="p_cur" value="&lt;b&gt;CurrentStageIndex&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;今いる県の番号（プロパティ）&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← OmiyageShelf・SaveManager が読む&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;dashed=1;fontStyle=2;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_prog"><mxGeometry x="15" y="320" width="240" height="59" as="geometry"/></mxCell><mxCell id="p_progress" value="&lt;b&gt;Progress&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;今の県で進んだ量（プロパティ）&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← SaveManager が読む&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;dashed=1;fontStyle=2;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_prog"><mxGeometry x="15" y="397" width="240" height="59" as="geometry"/></mxCell><mxCell id="p_view" value="&lt;b&gt;UpdateProgressView()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;バー・「次のエリアまで」・制覇数&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ MochiFormat の Format()&lt;/font&gt;&lt;br&gt;&lt;font color='#33691E'&gt;画面 Fill（anchorMax）・ProgressText&lt;/font&gt;&lt;br&gt;&lt;font color='#33691E'&gt;画面 JourneyText&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_prog"><mxGeometry x="305" y="58" width="240" height="89" as="geometry"/></mxCell><mxCell id="p_next" value="&lt;b&gt;GoNextStage()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;次の県へ進む／ゴール&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ StageView の ShowStage()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_prog"><mxGeometry x="305" y="175" width="240" height="59" as="geometry"/></mxCell><mxCell id="p_last" value="&lt;b&gt;IsLastStage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;最後の県か（プロパティ）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#ECEFF1;strokeColor=#78909C;dashed=1;fontStyle=2;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_prog"><mxGeometry x="305" y="292" width="240" height="44" as="geometry"/></mxCell><mxCell id="L_view" value="StageView.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている
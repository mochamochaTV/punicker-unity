x'&gt;Show〜()&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;マスに画像と名札を出す&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="1040" y="120" width="260" height="74" as="geometry"/></mxCell><mxCell id="s_progress" value="&lt;b&gt;StageProgress.cs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;CurrentStageIndex&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;今いる県（まだの県は「？」）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="1040" y="260" width="260" height="74" as="geometry"/></mxCell><mxCell id="s_tapslot" value="&lt;b&gt;マスを押す&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontSize=13;fillColor=#F1F8E9;strokeColor=#558B2F;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="170" height="70" as="geometry"/></mxCell><mxCell id="s_click" value="&lt;b&gt;OmiyageSlot.cs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;OnClick()&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;押されたことを知らせる&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="300" y="418" width="220" height="74" as="geometry"/></mxCell><mxCell id="s_select" value="&lt;b&gt;OmiyageShelf.cs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;OnSlotClicked()&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;そのおみやげを選ぶ → 詳細を出す&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="620" y="418" width="300" height="74" as="geometry"/></mxCell><mxCell id="s_price" value="&lt;b&gt;OmiyageShop.cs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;GetLevel()・GetPrice()&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;今のレベルと値段&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="1040" y="418" width="260" height="74" as="geometry"/></mxCell><mxCell id="s_buy" value="&lt;b&gt;購入ボタン&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontSize=13;fillColor=#F1F8E9;strokeColor=#558B2F;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="170" height="70" as="geometry"/></mxCell><mxCell id="s_onbuy" value="&lt;b&gt;OmiyageShelf.cs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;OnClickBuy()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="300" y="638" width="220" height="74" as="geometry"/></mxCell><mxCell id="s_trybuy" value="&lt;b&gt;OmiyageShop.cs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;TryBuy()&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;足りればレベル +1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="620" y="638" width="300" height="74" as="geometry"/></mxCell><mxCell id="s_spend" value="&lt;b&gt;MochiWallet.cs&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;TrySpend()&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;足りれば払う&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fontSize=13;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="1040" y="638" width="260" height="74" as="geometry"/></mxCell><mxCell id="n2" value="①" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#E65100;" edge="1" parent="1" source="s_idou" target
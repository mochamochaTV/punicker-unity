ntSize=12;fontSize=13;fillColor=#F1F8E9;strokeColor=#558B2F;" vertex="1" parent="1"><mxGeometry x="1280" y="150" width="240" height="60" as="geometry"/></mxCell><mxCell id="n2" value="①" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#37474F;" edge="1" parent="1" source="o_up" target="o_tap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n3" value="②" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#E65100;" edge="1" parent="1" source="o_tap" target="o_down"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n4" value="③" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#37474F;" edge="1" parent="1" source="o_down" target="o_fade"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n5" value="④" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#37474F;" edge="1" parent="1" source="o_fade" target="o_end"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;番号の順に起きること&lt;/b&gt;&lt;br&gt;① 開いた直後から、毎フレーム cos を使って「タップしてスタート」の透明度を 0.6〜1 の間で行き来させる（点滅）&lt;br&gt;② 画面のどこを押しても、StartScreen.cs の OnPointerDown() が呼ばれる&lt;br&gt;③ isHiding を true にして、タップを後ろのゲーム画面に通す（blocksRaycasts を false）&lt;br&gt;④ 0.6秒かけて透明・1.08倍にして、最後に SetActive(false) で消す" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=13;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1100" height="114" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;見かた&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1580" y="300" width="260" height="24" as="geometry"/></mxCell><mxCell id="n8" value="" st
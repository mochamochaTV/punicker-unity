fects の PlayTap()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFCDD2;strokeColor=#C62828;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_tap"><mxGeometry x="15" y="58" width="240" height="104" as="geometry"/></mxCell><mxCell id="tap_up" value="&lt;b&gt;Update()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;毎フレーム、タップ力を表示&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#607D8B'&gt;読む OmiyageShop の TapPower&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ MochiFormat の Format()&lt;/font&gt;&lt;br&gt;&lt;font color='#33691E'&gt;画面 TapPowerText&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_tap"><mxGeometry x="15" y="180" width="240" height="89" as="geometry"/></mxCell><mxCell id="L_start" value="StartScreen.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：StartScreen&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="270" height="263" as="geometry"/></mxCell><mxCell id="st_down" value="&lt;b&gt;OnPointerDown(eventData)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;消え始めの合図を出す&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#33691E'&gt;画面 blocksRaycasts を false に&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFCDD2;strokeColor=#C62828;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_start"><mxGeometry x="15" y="58" width="240" height="59" as="geometry"/></mxCell><mxCell id="st_up" value="&lt;b&gt;Update()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;点滅・消える動き&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#33691E'&gt;画面 Hint の alpha（点滅）&lt;/font&gt;&lt;br&gt;&lt;font color='#33691E'&gt;画面 StartScreen の alpha と大きさ&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_start"><mxGeometry x="15" y="175" width="240" height="74" as="geometry"/></mxCell><mxCell id="L_tapfx" value="TapEffects.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：TapEffects&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="660" y="70" width="270" height="206" as="geometry"/></mxCell><mxCell id="fx_play" value="&lt;b&gt;PlayTap(screenPosition, amount)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;押した場所に浮かぶ文字を作る&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← MochisukeTap の OnPointerDown()&lt;/font&gt;&lt;br&gt;&lt;font color='#607D8B'&gt;読む EffectLayer の childCount（40個まで）&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ RectTransformUtility で位置を直す&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ Instantiate（FloatingText の Prefab）&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ FloatingText の Setup()&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ MochiFormat の Format()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_tapfx"><mxGeometry x="15" y="58" width="240" height="134" as="geometry"/></mxCell><mxCell id="L_float" value="FloatingText.cs&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;付いている物：FloatingText の Prefab（ひな形）&lt;/font&gt;" style="swimlane;html=1;whiteSpace=wrap;startSize=44;rounded=1;arcSize=4;fontSize=13;fillColor=#CFD8DC;swimlaneFillColor=#FAFAFA;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="970" y="70" width="270" height="355" as="geometry"/></mxCell><mxCell id="ft_setup" value="&lt;b&gt;Setup(message)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;表示する文字を決める&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#BF360C'&gt;← TapEffects の PlayTap()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_float"><mxGeometry x="15" y="58" width="240" height="59" as="geometry"/></mxCell><mxCell id="ft_start" value="&lt;b&gt;Start()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;出た場所を覚える&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ GetComponent&lt;RectTransform&gt;()&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_float"><mxGeometry x="15" y="135" width="240" height="59" as="geometry"/></mxCell><mxCell id="ft_up" value="&lt;b&gt;Update()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;0.6秒でふくらんで浮いて消える&lt;/font&gt;&lt;div style='font-size:10px;text-align:left;margin-top:3px'&gt;&lt;font color='#263238'&gt;→ Mathf.Lerp で大きさ・高さ&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ text.alpha で透明に&lt;/font&gt;&lt;br&gt;&lt;font color='#263238'&gt;→ Destroy で自分を消す&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;verticalAlign=top;spacingTop=4;" vertex="1" parent="L_float"><mxGeometry x="15" y="252" width="240" height="89" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;見かた&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1600" y="70" width="380" height="24" as="geometry"/></mxCell><mxCell id="n3" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFE0B2;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="1600" y="100" width="40" height="22" as="geometry"/></mxCell><mxCell id="n4" value="Unity が自動で呼ぶ（Awake・Start・Update など）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1650" y="98" width="330" height="26" as="geometry"/></mxCell><mxCell id="n5" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFCDD2;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="1600" y="130" width="40" height="22" as="geometry"/></mxCell><mxCell id="n6" value="タップで Unity が呼ぶ（OnPointerDown）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1650" y="128" width="330" height="26" as="geometry"/></mxCell><mxCell id="n7" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E1BEE7;strokeColor=#6A1B9A;" vertex="1" parent="1"><mxGeometry x="1600" y="160" width="40" height="22" as="geometry"/></mxCell><mxCell id="n8" value="Button の On Click() から呼ばれる" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1650" y="158" width="330" height="26" as="geometry"/></mxCell><mxCell id="n9" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#455A64;" vertex="1" parent="1"><mxGeometry x="1600" y="190" width="40" height="22" as="geometry"/></mxCell><mxCell id="n10" value="スクリプトから呼ばれる関数" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1650" y="188" width="330" height="26"
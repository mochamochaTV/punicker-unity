t="s_onbuy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#37474F;" edge="1" parent="1" source="s_onbuy" target="s_trybuy"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;fontSize=13;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeWidth=2;strokeColor=#37474F;" edge="1" parent="1" source="s_trybuy" target="s_spend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;番号の順に起きること&lt;/b&gt;&lt;br&gt;① 移動ボタンの On Click() で、ShopPanel を表示する（SetActive）&lt;br&gt;② 表示されたので、OmiyageShelf.cs が動き出す（最初に1回 Start()、そのあと毎フレーム Update()）&lt;br&gt;③ 9マスに、今のページのおみやげを出す。今いる県より先のおみやげは「？」にする&lt;br&gt;④ マスを押すと、そのおみやげを選んで、レベル・値段を詳細パネルに出す&lt;br&gt;⑤ 購入ボタンで、もちが足りれば払って、おみやげのレベルを1上げる（次のフレームで表示も変わる）&lt;br&gt;閉じるときは、戻るボタン（BackButton）の On Click() で ShopPanel を非表示にする" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontSize=13;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1100" height="158" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;見かた&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="80" width="260" height="24" as="geometry"/></mxCell><mxCell id="n14" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFF3E0;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="1420" y="110" width="40" height="22" as="geometry"/></mxCell><mxCell id="n15" value="Unity の仕組み" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1470" y="108" width="210" height="26" as="geometry"/></mxCell><mxCell id="n16" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFEBEE;strokeColor=#C62828;" vertex="1" parent="1"><mxGeometry x="1420" y="140" width="40" height="22" as="geometry"/></mxCell><mxCell id="n17" value="入力" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1470" y="138" width="210" height="26" as="geometry"/></mxCell><mxCell id="n18" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E3F2FD;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="1420" y="170" width="40" height="22" as="geometry"/></mxCell><mxCell id="n19" value="数を持つ・計算・保存" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1470" y="168" width="210" height="26" as="geometry"/></mxCell><mxCell id="n20" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFF8E1;strokeColor=#F9A825;" vertex="1" parent="1"><mxGeometry x="1420" y="200" width="40" height="22" as="geometry"/></mxCell><mxCell id="n21" value="表示・演出" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1470" y="198" width="210" height="26" as="geometry"/></mxCell><mxCell id="n22" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;rounded=0;fillColor=#F1F8E9;strokeColor=#558B2F;" vertex="1" parent="1"><mxGeometry x="1420" y="230" width="40" height="22" as="geometry"/></mxCell><mxCell id="n23" value="画面の部品" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1470" y="228" width="210" height="26" as="geometry"/></mxCell><mxCell id="n24" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1420" y="271" width="1" height="1" as="geometry"/></mxCell><mxCell id="n25" value="" style="text;html=1;" vertex="1" parent="1"><mxGeometry x="1460" y="271" width="1" height="1" a